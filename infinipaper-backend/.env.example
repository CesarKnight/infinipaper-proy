# ============================================================
# Infinipaper - variables de entorno del backend
# Copia este archivo a `.env` y ajusta los valores.
#   cp .env.example .env
# ============================================================

NODE_ENV=development
PORT=3000

# --- Base de datos ---------------------------------------------
# En docker-compose el host es `db`; en local con `docker compose up db`
# el puerto host es 5433.
DATABASE_URL=postgresql://infinipaper:infinipaper@localhost:5433/infinipaper?schema=public

# --- Sesión -----------------------------------------------------
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=session
COOKIE_SECURE=false

# --- CORS / origen ---------------------------------------------
FRONTEND_URL=http://localhost:3000

# --- Almacenamiento S3 / MinIO ---------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=infinipaper
S3_SECRET_KEY=infinipaper
S3_BUCKET=infinipaper
S3_FORCE_PATH_STYLE=true

# Imagen de MinIO (https://hub.docker.com/r/firstfinger/minio).
# Usa latest-arm64 en equipos ARM.
MINIO_IMAGE_TAG=latest-amd64
# Puertos host: API, consola integrada y Admin Console.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ADMIN_CONSOLE_PORT=9002

# --- Subida -----------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# --- Transcripción (ASR) ---------------------------------------
ASR_URL=http://localhost:8000
ASR_API_KEY=
ASR_DEFAULT_LANGUAGE=es
ASR_MAX_DURATION_MINUTES=120

# --- Reglas de negocio -----------------------------------------
AVISO_FILENAME=aviso.md

# --- Estructuración de apuntes con agentes IA ------------------
AGENT_SERVICE_URL=http://localhost:8100
AGENT_SERVICE_TOKEN=dev-agent-token
AGENT_TIMEOUT_MS=120000
AGENT_STRUCTURING_ENABLED=true
AGENT_MAX_INPUT_CHARS=120000
S3_PRESIGN_TTL_SECONDS=900

# --- Servicio de agentes (docker compose) ----------------------
AGENT_PORT=8100
MODEL_NAME=gpt-4o-mini
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_STRUCTURER=
MODEL_EXTRACTOR=
MODEL_VISION=
MODEL_TEMPERATURE=0.1
# ID exacto habilitado en la región; p. ej. us-east-2: openai.gpt-oss-120b-1:0
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
AWS_PROFILE=infinipaper
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
AGENT_OPENCODE_SESSION_ID=infinipaper-agents
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=1
AGENT_PROMPT_VERSION=note-structurer/v1
OTEL_ENABLED=false
LOG_LEVEL=INFO
