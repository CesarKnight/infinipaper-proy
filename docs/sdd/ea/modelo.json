  "classModel": {
    "name": "Clases · Modelo de dominio",
    "classes": [
      {
        "name": "User",
        "stereotype": "entity",
        "notes": "avatarUrl y bio son opcionales.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "username", "type": "String" },
          { "name": "email", "type": "String" },
          { "name": "passwordHash", "type": "String" },
          { "name": "displayName", "type": "String" },
          { "name": "avatarUrl", "type": "String" },
          { "name": "bio", "type": "String" },
          { "name": "status", "type": "UserStatus" },
          { "name": "createdAt", "type": "DateTime" },
          { "name": "updatedAt", "type": "DateTime" }
        ]
      },
      {
        "name": "Session",
        "stereotype": "entity",
        "notes": "tokenHash guarda el SHA-256 del token.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "userId", "type": "String" },
          { "name": "tokenHash", "type": "String" },
          { "name": "expiresAt", "type": "DateTime" },
          { "name": "createdAt", "type": "DateTime" }
        ]
      },
      {
        "name": "Project",
        "stereotype": "entity",
        "notes": "description es opcional. ownerId es la fuente del rol Owner.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "ownerId", "type": "String" },
          { "name": "name", "type": "String" },
          { "name": "description", "type": "String" },
          { "name": "visibility", "type": "ProjectVisibility" },
          { "name": "createdAt", "type": "DateTime" },
          { "name": "updatedAt", "type": "DateTime" }
        ]
      },
      {
        "name": "ProjectMember",
        "stereotype": "entity",
        "notes": "role solo admite EDITOR o VIEWER; el Owner no se guarda aquí.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "projectId", "type": "String" },
          { "name": "userId", "type": "String" },
          { "name": "role", "type": "ProjectRole" },
          { "name": "createdAt", "type": "DateTime" },
          { "name": "updatedAt", "type": "DateTime" }
        ]
      },
      {
        "name": "Folder",
        "stereotype": "entity",
        "notes": "parentId es opcional; la raíz tiene isRoot=true.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "projectId", "type": "String" },
          { "name": "parentId", "type": "String" },
          { "name": "name", "type": "String" },
          { "name": "isRoot", "type": "Boolean" },
          { "name": "createdAt", "type": "DateTime" },
          { "name": "updatedAt", "type": "DateTime" }
        ]
      },
      {
        "name": "Resource",
        "stereotype": "entity",
        "notes": "checksum es opcional; s3Key es único. Representa archivos, avisos y apuntes.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "folderId", "type": "String" },
          { "name": "authorId", "type": "String" },
          { "name": "name", "type": "String" },
          { "name": "kind", "type": "ResourceKind" },
          { "name": "mimeType", "type": "String" },
          { "name": "size", "type": "Int" },
          { "name": "s3Key", "type": "String" },
          { "name": "checksum", "type": "String" },
          { "name": "createdAt", "type": "DateTime" },
          { "name": "updatedAt", "type": "DateTime" }
        ]
      },
      {
        "name": "TranscriptionJob",
        "stereotype": "entity",
        "notes": "text y error son opcionales.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "resourceId", "type": "String" },
          { "name": "requestedById", "type": "String" },
          { "name": "status", "type": "TranscriptionStatus" },
          { "name": "language", "type": "String" },
          { "name": "text", "type": "String" },
          { "name": "error", "type": "String" },
          { "name": "createdAt", "type": "DateTime" },
          { "name": "updatedAt", "type": "DateTime" }
        ]
      },
      {
        "name": "NoteStructureJob",
        "stereotype": "entity",
        "notes": "resultMarkdown, outline, warnings, error y usage son opcionales.",
        "attributes": [
          { "name": "id", "type": "String" },
          { "name": "resourceId", "type": "String" },
          { "name": "requestedById", "type": "String" },
          { "name": "status", "type": "AgentJobStatus" },
          { "name": "language", "type": "String" },
          { "name": "instructions", "type": "String" },
          { "name": "sourceChecksum", "type": "String" },
          { "name": "resultMarkdown", "type": "String" },
          { "name": "resultResourceId", "type": "String" },
          { "name": "outline", "type": "Json" },
          { "name": "warnings", "type": "Json" },
          { "name": "error", "type": "String" },
          { "name": "model", "type": "String" },
          { "name": "promptVersion", "type": "String" },
          { "name": "inputTokens", "type": "Int" },
          { "name": "outputTokens", "type": "Int" },
          { "name": "createdAt", "type": "DateTime" },
