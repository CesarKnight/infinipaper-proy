{
  "rootPackage": "Infinipaper SDD",
  "diagramPackages": {
    "useCases": "01 · Casos de uso",
    "packages": "02 · Paquetes",
    "c4": "03 · Arquitectura C4",
    "sequences": "04 · Secuencias",
    "classes": "05 · Clases"
  },
  "actors": [
    { "name": "Visitante", "notes": "Usuario no autenticado. Solo accede a proyectos públicos y a registro/login." },
    { "name": "Usuario", "notes": "Usuario autenticado. Puede crear proyectos y consultar su dashboard." },
    { "name": "Owner", "notes": "Propietario del proyecto. Control total y gestión de participantes." },
    { "name": "Editor", "notes": "Participante con permiso de escritura sobre el contenido del proyecto." },
    { "name": "Viewer", "notes": "Participante con permiso de solo lectura." },
    { "name": "Whisper ASR", "notes": "Sistema externo de reconocimiento automático del habla." },
    { "name": "MinIO", "notes": "Sistema externo de almacenamiento de objetos compatible con S3." },
    { "name": "LLM", "notes": "Proveedor de modelo de lenguaje configurable usado por el servicio de agentes." }
  ],
  "useCases": [
    {
      "id": "UC-01",
      "name": "Gestión de usuarios",
      "spec": "001",
      "actors": ["Visitante", "Usuario"],
      "notes": "Registro, login, logout, perfil, avatar, cambio de contraseña y archivado de cuenta."
    },
    {
      "id": "UC-02",
      "name": "Gestión de proyectos",
      "spec": "002",
      "actors": ["Visitante", "Usuario", "Owner", "Viewer"],
      "notes": "Crear, listar, ver, editar y eliminar proyectos; proyectos públicos y carpeta raíz."
    },
    {
      "id": "UC-03",
      "name": "Gestión de carpetas",
      "spec": "003",
      "actors": ["Owner", "Editor", "Viewer"],
      "notes": "Árbol de carpetas, creación, renombrado, movimiento, borrado en cascada y orden."
    },
    {
      "id": "UC-04",
      "name": "Aviso en carpeta",
      "spec": "004",
      "actors": ["Owner", "Editor", "Viewer", "MinIO"],
      "notes": "Aviso Markdown configurable, visible y renderizado al tope de la carpeta."
    },
    {
      "id": "UC-05",
      "name": "Gestión de archivos",
      "spec": "005",
      "actors": ["Owner", "Editor", "Viewer", "MinIO"],
      "notes": "Subida, listado, descarga, renombrado y borrado de archivos con límite configurable."
    },
    {
      "id": "UC-06",
      "name": "Visualización multimedia",
      "spec": "006",
      "actors": ["Visitante", "Usuario", "Viewer", "MinIO"],
      "notes": "Visores de imagen, PDF, audio, video y Markdown; descarga para ofimáticos."
    },
    {
      "id": "UC-07",
      "name": "Gestión de participantes",
      "spec": "007",
      "actors": ["Owner"],
      "notes": "Buscar, añadir, listar y retirar participantes de un proyecto."
    },
    {
      "id": "UC-08",
      "name": "Gestión de permisos",
      "spec": "008",
      "actors": ["Owner", "Editor", "Viewer"],
      "notes": "Roles Owner, Editor y Viewer; autorización en servidor y acceso público de lectura."
    },
    {
      "id": "UC-09",
      "name": "Gestión de apuntes",
      "spec": "009",
      "actors": ["Owner", "Editor", "Viewer", "MinIO"],
      "notes": "Apuntes Markdown con MDXEditor, autoguardado, sanitización y permisos."
    },
    {
      "id": "UC-10",
      "name": "Transcripción de audio",
      "spec": "010",
      "actors": ["Usuario", "Owner", "Editor", "Whisper ASR"],
      "notes": "Job asíncrono de transcripción, polling y guardado como apunte."
    },
    {
      "id": "UC-11",
      "name": "Dashboard personal",
      "spec": "011",
      "actors": ["Usuario", "Owner", "Editor", "Viewer"],
      "notes": "Resumen de proyectos propios, participados y públicos en carruseles."
    },
    {
      "id": "UC-12",
      "name": "Estructuración de apuntes con IA",
      "spec": "012",
      "actors": ["Owner", "Editor", "LLM"],
      "notes": "Job asíncrono que estructura un apunte Markdown con LangGraph y devuelve un nuevo apunte."
    }
  ],
  "packageModel": {
    "name": "Sistema",
    "notes": "Vista de paquetes del sistema Infinipaper.",
    "children": [
      {
        "name": "infinipaper-frontend",
        "notes": "Aplicación Next.js 16 con App Router.",
        "children": [
          { "name": "app", "notes": "Rutas, layouts y páginas (specs 001–011)." },
          { "name": "components", "notes": "UI y componentes de dominio (specs 002–011)." },
          { "name": "lib", "notes": "Cliente API, hooks, tipos y utilidades (specs 001–011)." }
        ]
      },
      {
        "name": "infinipaper-backend",
        "notes": "API NestJS 12 con Prisma 7.",
        "children": [
          { "name": "modules", "notes": "auth, users, projects, folders, resources, members, transcriptions, note-structure y dashboard." },
          { "name": "common", "notes": "guards, permissions, storage, prisma, config y errores." },
          { "name": "prisma", "notes": "Esquema, migraciones y cliente generado." }
        ]
      },
      {
        "name": "infinipaper-agents",
        "notes": "Servicio FastAPI + LangGraph para estructuración de apuntes.",
        "children": [
          { "name": "api", "notes": "Endpoints FastAPI y autenticación interna." },
          { "name": "graph", "notes": "Grafo LangGraph y nodos de extracción y estructuración." },
          { "name": "tools", "notes": "Descarga presignada y utilidades de Markdown." }
        ]
      },
      {
        "name": "Infraestructura",
        "notes": "Servicios externos y persistencia.",
        "children": [
          { "name": "PostgreSQL", "notes": "Base de datos relacional (PostgreSQL 17)." },
          { "name": "MinIO", "notes": "Almacenamiento de objetos compatible con S3." },
          { "name": "Whisper ASR", "notes": "Servicio autoalojado de transcripción." },
          { "name": "pg-boss", "notes": "Cola de trabajos respaldada por PostgreSQL." },
          { "name": "LLM", "notes": "Proveedor de modelo de lenguaje: AWS Bedrock, OpenCode Go u OpenAI-compatible." }
        ]
      }
    ]
  },
  "packageDependencies": [
    { "from": "Sistema/infinipaper-frontend/app", "to": "Sistema/infinipaper-frontend/components", "label": "usa" },
    { "from": "Sistema/infinipaper-frontend/app", "to": "Sistema/infinipaper-frontend/lib", "label": "usa" },
    { "from": "Sistema/infinipaper-frontend/components", "to": "Sistema/infinipaper-frontend/lib", "label": "usa" },
    { "from": "Sistema/infinipaper-frontend/lib", "to": "Sistema/infinipaper-backend/modules", "label": "/api/v1 (rewrites)" },
    { "from": "Sistema/infinipaper-backend/modules", "to": "Sistema/infinipaper-backend/common", "label": "usa" },
    { "from": "Sistema/infinipaper-backend/modules", "to": "Sistema/infinipaper-backend/prisma", "label": "usa" },
    { "from": "Sistema/infinipaper-backend/prisma", "to": "Sistema/Infraestructura/PostgreSQL", "label": "SQL" },
    { "from": "Sistema/infinipaper-backend/modules", "to": "Sistema/Infraestructura/MinIO", "label": "S3" },
    { "from": "Sistema/infinipaper-backend/modules", "to": "Sistema/Infraestructura/Whisper ASR", "label": "HTTP" },
    { "from": "Sistema/infinipaper-backend/modules", "to": "Sistema/Infraestructura/pg-boss", "label": "jobs" },
    { "from": "Sistema/Infraestructura/pg-boss", "to": "Sistema/Infraestructura/PostgreSQL", "label": "persistencia" },
    { "from": "Sistema/infinipaper-backend/modules", "to": "Sistema/infinipaper-agents/api", "label": "HTTP interno" },
    { "from": "Sistema/infinipaper-agents/api", "to": "Sistema/infinipaper-agents/graph", "label": "invoca" },
    { "from": "Sistema/infinipaper-agents/graph", "to": "Sistema/infinipaper-agents/tools", "label": "usa" },
    { "from": "Sistema/infinipaper-agents/tools", "to": "Sistema/Infraestructura/MinIO", "label": "GET presignado" },
    { "from": "Sistema/infinipaper-agents/graph", "to": "Sistema/Infraestructura/LLM", "label": "prompts" }
  ],
