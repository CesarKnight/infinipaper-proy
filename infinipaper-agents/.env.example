AGENT_SERVICE_TOKEN=dev-agent-token

MODEL_NAME=gpt-4o-mini
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_STRUCTURER=
MODEL_EXTRACTOR=
MODEL_VISION=
MODEL_TEMPERATURE=0.1

# --- AWS Bedrock (MODEL_PROVIDER=bedrock) ----------------------
# Si usas un rol IAM, deja AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY vacíos.
# Obligatorio si MODEL_PROVIDER=bedrock: ID/ARN habilitado en tu cuenta.
# El ID varía por región; p. ej. us-east-2: openai.gpt-oss-120b-1:0
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
AWS_PROFILE=infinipaper
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- OpenCode Go (MODEL_PROVIDER=opencode-go) ------------------
# Crea una API key en https://opencode.ai/console/account#api-keys
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
AGENT_OPENCODE_SESSION_ID=infinipaper-agents

AGENT_MAX_INPUT_CHARS=120000
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=1
AGENT_PROMPT_VERSION=note-structurer/v1

OTEL_ENABLED=false
LOG_LEVEL=INFO
